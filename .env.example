# ─────────────────────────────────────────────────────────────────────────────
# spec0 environment template. Copy to .env (gitignored) and fill in.
# See DEPLOYMENT.md for the full production checklist.
#
# LOCAL-ONLY flags (never set in production): MESH_MOCK, INNGEST_DEV, and a
# localhost DATABASE_URL. Keep those in .env.local, not here / not on Vercel.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ───────────────────────────────────────────────
# PROD: set to your deployed origin, e.g. https://spec0.app (used for Clerk/Stripe redirects & webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# PROD: leave unset — the host (Vercel) sets NODE_ENV=production automatically
NODE_ENV=development

# ─── Auth (Clerk) ── REQUIRED ──────────────────────────
# PROD: use a Clerk PRODUCTION instance → pk_live_... / sk_live_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# REQUIRED for the users-mirror webhook. Get it from Clerk → Webhooks after
# adding endpoint https://<domain>/api/webhooks/clerk (user.created/updated).
CLERK_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── Database (Neon Postgres) ── REQUIRED ──────────────
# POOLED url for the app; DIRECT/unpooled url for migrations (drizzle-kit).
# Apply schema to prod: see DEPLOYMENT.md §1 (npm run db:migrate).
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.neon.tech/db?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require

# ─── LLM gateway (Mesh API) ── REQUIRED ────────────────
MESH_API_KEY=rsk_xxx                           # Router Service Key (Bearer token)
MESH_BASE_URL=https://api.meshapi.ai/v1
# VERIFY exact IDs on the Mesh "Models" page before relying on them.
MODEL_RESEARCH=anthropic/claude-sonnet-5
MODEL_DRAFTING=anthropic/claude-sonnet-5
MODEL_REFINE=anthropic/claude-opus-4.8         # quality gate → strongest model
MODEL_ADDONS=anthropic/claude-sonnet-5
MODEL_LIGHT=google/gemini-2.5-flash
MESH_ENABLE_WEB_SEARCH=true
# PROD: set a per-key SPEND CAP + RPM/RPD/TPM in the Mesh dashboard (budget backstop).
# LOCAL-ONLY (put in .env.local, NOT here): MESH_MOCK=true → deterministic stub LLM.

# ─── Background orchestration (Inngest) ── REQUIRED in prod ──
# Get BOTH from the Inngest dashboard. Event Key != Signing Key (signkey-...).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=signkey-...
# LOCAL-ONLY (put in .env.local, NOT here): INNGEST_DEV=1 → use local Dev Server.

# ─── Object storage (AWS S3) ── needed for image uploads only ──
# Links + zip export work WITHOUT S3. Required only for UI/UX image uploads.
# AWS_* are read directly by the AWS SDK (not validated in env.ts).
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
S3_BUCKET=spec0-uploads-xxx
S3_PUBLIC_BASE_URL=https://spec0-uploads-xxx.s3.eu-north-1.amazonaws.com
# Set CORS on the bucket to allow PUT/GET from your app origin.

# ─── Payments (Razorpay) ── needed for over-quota purchases ──
# Dashboard → Settings → API Keys. Use rzp_test_* locally, rzp_live_* in prod.
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
# PROD: Razorpay dashboard → Webhooks → add https://<domain>/api/webhooks/razorpay
# (event: payment.captured) and put its secret here.
RAZORPAY_WEBHOOK_SECRET=
PROJECT_PRICE_INR=199

# ─── Observability ── E6, optional ─────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com
SENTRY_DSN=

# ─── Email (Resend) ── E6, not built yet ───────────────
RESEND_API_KEY=re_xxx
EMAIL_FROM="Spec0 <noreply@yourdomain.com>"

# ─── App config / limits ───────────────────────────────
FREE_PROJECTS_PER_MONTH=1
MAX_REFERENCE_UPLOADS=5
MAX_UPLOAD_MB=10

# ─── Build/CI escape hatch ─────────────────────────────
# Set "true" to skip env validation (e.g. building without real secrets).
SKIP_ENV_VALIDATION=
